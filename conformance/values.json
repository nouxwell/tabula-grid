	"checks": {
		"about": "Rows as the grid holds them, checked by SheetValidator in the browser and by Tabula::checkRows() on the server, which is sent them. A lookup goes as its id, or as { label } when it was never matched; \"sent\" gives any other value the grid sends in another form than it holds. Both sides must find the same issues: row, field, code, targets, and the params listed.",
		"settings": "tr",
		"fields": [
			{
				"key": "product",
				"type": "lookup",
				"lookup": "product",
				"required": true,
				"rules": [{ "rule": "unique" }]
			},
			{ "key": "sku", "type": "string", "editable": false, "submit": false },
			{ "key": "rank", "type": "integer", "rules": [{ "rule": "unique" }] },
			{ "key": "quantity", "type": "integer" },
			{
				"key": "price",
				"type": "money",
				"currency": "TRY",
				"required": true,
				"rules": [
					{ "rule": "min", "value": "0" },
					{ "rule": "max", "value": "1000" }
				]
			},
			{
				"key": "currency",
				"type": "options",
				"options": [
					{ "value": "TRY", "label": "Türk lirası" },
					{ "value": "EUR", "label": "Avro" }
				]
			},
			{ "key": "validFrom", "type": "date" },
			{ "key": "publishAt", "type": "datetime" },
			{ "key": "active", "type": "bool" },
			{
				"key": "note",
				"type": "string",
				"rules": [
					{ "rule": "minLength", "value": 3 },
					{ "rule": "maxLength", "value": 5 }
				]
			},
			{
				"key": "code",
				"type": "string",
				"rules": [{ "rule": "maxLength", "value": 4 }, { "rule": "unique" }]
			}
		],
