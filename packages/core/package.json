{
	"name": "@nouxwell/tabula-core",
	"version": "0.1.0",
	"description": "The framework-free core of Tabula Grid.",
	"keywords": [
		"spreadsheet",
		"data-grid",
		"bulk-edit",
		"validation",
		"excel",
		"import",
		"tabula"
	],
	"license": "MIT",
	"author": "Hüseyin Niyazi Balın",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nouxwell/tabula-grid.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/nouxwell/tabula-grid/tree/main/packages/core#readme",
	"bugs": {
		"url": "https://github.com/nouxwell/tabula-grid/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	}
}
