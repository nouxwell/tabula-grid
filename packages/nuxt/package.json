{
	"name": "@nouxwell/tabula-nuxt",
	"version": "0.8.0",
	"description": "The Nuxt module of Tabula Grid.",
	"keywords": [
		"nuxt",
		"nuxt-module",
		"vue",
		"spreadsheet",
		"data-grid",
		"tabula"
	],
	"license": "MIT",
	"author": "Hüseyin Niyazi Balın",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nouxwell/tabula-grid.git",
		"directory": "packages/nuxt"
	},
	"homepage": "https://github.com/nouxwell/tabula-grid/tree/main/packages/nuxt#readme",
	"bugs": {
		"url": "https://github.com/nouxwell/tabula-grid/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/module.d.ts",
			"import": "./dist/module.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@nouxwell/tabula-vue": "workspace:^",
		"@nuxt/kit": "^4.6.4"
	},
	"devDependencies": {
		"@nuxt/schema": "^4.6.4"
	}
}
