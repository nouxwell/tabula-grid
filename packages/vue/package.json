	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && vue-tsc -p tsconfig.build.json",
		"typecheck": "vue-tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@nouxwell/tabula-core": "workspace:*"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"vue": "^3.5.45"
	}
}
